{"nodes": [{"id": "core_pubsub_pubsub_guide", "label": "Pub/Sub load testing guide", "file_type": "concept", "source_file": "docs/core/pubsub.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_pubsub_memory_driver", "label": "memory pubsub driver (in-process broadcast bus)", "file_type": "concept", "source_file": "docs/core/pubsub.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One channel per subject shared by all VUs \u2014 cross-VU fan-out is a feature, not leakage. Needs no broker: fastest way to build test logic and shows the engine's raw ceiling; diffing against a real broker driver isolates what the broker costs."}, {"id": "core_pubsub_nats_driver", "label": "nats pubsub driver (core NATS via async-nats)", "file_type": "concept", "source_file": "docs/core/pubsub.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Core NATS only: no JetStream persistence, streams, or queue groups \u2014 a subscriber not yet connected misses messages, so the step subscribes first to keep same-step roundtrips safe."}, {"id": "core_pubsub_nats_server", "label": "NATS server", "file_type": "concept", "source_file": "docs/core/pubsub.md", "source_location": null, "source_url": "https://nats.io", "captured_at": null, "author": null, "contributor": null}, {"id": "core_pubsub_pro_drivers", "label": "Pro vendor drivers (Kafka, Redis, MQTT)", "file_type": "concept", "source_file": "docs/core/pubsub.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vendor drivers are a pro capability registered on the same driver seam; their tuning travels in the step's options object, and an unknown driver value fails the step listing registered drivers so it is always clear which build you are running."}, {"id": "core_pubsub_pubsub_metrics", "label": "Pub/Sub metrics (pubsub_msgs_published, pubsub_msgs_received, pubsub_e2e_ms)", "file_type": "concept", "source_file": "docs/core/pubsub.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_pubsub_connection_posture", "label": "Pub/Sub connection posture (full cycle per exchange)", "file_type": "rationale", "source_file": "docs/core/pubsub.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every exchange is connect \u2192 subscribe \u2192 publish \u2192 collect \u2192 drop with no pooling across steps or iterations, which keeps the e2e measurement honest (connect cost included) but makes brokers see real connection churn \u2014 size test rates accordingly and prefer duration-bounded runs against shared staging brokers."}], "edges": [{"source": "core_pubsub_pubsub_guide", "target": "core_actions_std_pubsub_v1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/core/pubsub.md", "source_location": null, "weight": 1.0}, {"source": "core_pubsub_memory_driver", "target": "core_actions_std_pubsub_v1", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/core/pubsub.md", "source_location": null, "weight": 1.0}, {"source": "core_pubsub_nats_driver", "target": "core_actions_std_pubsub_v1", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/core/pubsub.md", "source_location": null, "weight": 1.0}, {"source": "core_pubsub_nats_driver", "target": "core_pubsub_nats_server", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/core/pubsub.md", "source_location": null, "weight": 1.0}, {"source": "core_pubsub_pro_drivers", "target": "core_pubsub_memory_driver", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confide