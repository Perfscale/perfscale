 "weight": 1.0}, {"source": "core_actions_action_handler", "target": "core_actions_actions_rs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/core/actions.md", "source_location": null, "weight": 1.0}, {"source": "core_actions_builtin_actions", "target": "core_actions_actions_rs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/core/actions.md", "source_location": null, "weight": 1.0}, {"source": "core_actions_ws_family", "target": "core_actions_interpolation", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/core/actions.md", "source_location": null, "weight": 1.0}, {"source": "core_actions_grpc_family", "target": "core_actions_interpolation", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/core/actions.md", "source_location": null, "weight": 1.0}, {"source": "core_actions_ws_family", "target": "core_actions_grpc_family", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/core/actions.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "live_connection_step_pattern", "label": "One-shot vs live connection held across steps by id", "nodes": ["core_actions_ws_family", "core_actions_grpc_family", "core_actions_db_family"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/core/actions.md"}]}