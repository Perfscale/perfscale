{"nodes": [{"id": "core_metrics_http_req_metrics", "label": "Request metrics (http_req_*)", "file_type": "document", "source_file": "docs/core/metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Steps whose duration says nothing about target latency (ws-recv, ws-ping, grpc streams, db steps, process actions) deliberately do not feed http_req_duration, because that would poison the shared percentiles."}, {"id": "core_metrics_stats_lines", "label": "Live [stats] lines", "file_type": "document", "source_file": "docs/core/metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Machine-readable lines every 5 seconds exist for streaming consumers (the controlplane parses them out of the log stream); the histogram is never reset so cumulative percentiles converge instead of jittering."}, {"id": "core_metrics_custom_metrics", "label": "Custom metrics (value.metrics channel)", "file_type": "concept", "source_file": "docs/core/metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_metrics_failure_rate_metrics", "label": "Failure-rate metrics (<family>_failed)", "file_type": "concept", "source_file": "docs/core/metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One 0/1 sample is recorded per invocation (not per duration sample), so failed/total is exactly the step family's failure rate \u2014 which is what std/thresholds@v1 evaluates with rate."}, {"id": "core_metrics_quiet_mode", "label": "--quiet mode", "file_type": "concept", "source_file": "docs/core/metrics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "core_metrics_report_forwarding", "label": "Summary forwarding (report)", "file_type": "concept", "sou